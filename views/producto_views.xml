<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--Vista Tree: Arbol (CON LÓGICA
  CONDICIONAL)-->
  <record id="view_producto_tree" model="ir.ui.view">
    <field name="name">gestion.producto.tree</field>
    <field name="model">gestion.producto</field>
    <field name="arch" type="xml">
      <tree>
        <field name="codigo" string="SKU" />
        <field name="name" string="Nombre" />
        <field name="estado" string="Estado" widget="badge" decoration-info="estado=='en_revision'"
          decoration-danger="estado=='rechazado'" decoration-success="estado=='aprobado'" />
        <!--Indicadores
        temporales con iconos-->
        <field name="dias_para_vencer" string="Días venc." widget="progressbar"
          options="{'max_value': 365, 'editable': false}"
          decoration-danger="dias_para_vencer &lt; 0"
          decoration-warning="esta_por_vencer==True and dias_para_vencer &gt;=0" />
        <field name="esta_por_vencer" invisible="1" />
        <field name="fecha_vencimiento" string="Vencimiento" widget="date" />
        <field name="necesita_revision" string="Revisión" widget="boolean" />
        <field name="alerta_stock_bajo" string="Alerta Stock Bajo" widget="boolean"
          decoration-danger="alerta_stock_bajo" />
        <field name="cantidad_stock" string="Cantidad en stock" />
        <field name="vida_util_meses" string="Vida útil (meses)" />
        <field name="precio_venta" string="Precio de venta" />
        <field name="esta_activo" string="Activo" invisible="1" />
        <field name="es_fragil" string="Es fragil" />
        <field name="requiere_refrigeracion" string="Requiere Refrigeracion" />
      </tree>
    </field>
  </record>

  <!--Vista
  Form: Formulario-->
  <record id="view_producto_form" model="ir.ui.view">
    <field name="name">gestion.producto.form</field>
    <field name="model">gestion.producto</field>
    <field name="arch" type="xml">
      <form>
        <!--Encabezado
        del formulario-->
        <header>
          <!--Botones
          contextuales-->
          <!--Segun
          estado-->
          <!--En
          revisión-->
          <button
            name="action_enviar_revision"
            string="Enviar a Revisión"
            type="object"
            class="btn-primary"
            attrs="{'invisible': [('estado', 'not in', ['borrador','rechazado'])]}" />
          <!--Boton
          para aprobar-->
          <button
            name="action_aprobar"
            string="Aprobar"
            type="object"
            class="btn-success"
            attrs="{'invisible': [('estado', '!=', 'en_revision')]}" />
          <!--Botón
          para rechazar-->
          <button
            name="action_rechazar"
            string="Rechazar"
            type="object"
            class="btn-danger"
            attrs="{'invisible': [('estado', 'not in', ['aprobado', 'en_revision'])]}" />
          <!--Botón
          para archivar-->
          <button
            name="action_archivar"
            string="Archivar"
            type="object"
            class="btn-secondary"
            attrs="{'invisible': [('estado', 'not in', ['aprobado', 'en_revision'])]}" />
          <!--Botón
          para reactivar-->
          <button
            name="action_reactivar_producto_archivo"
            string="Reactivar producto desde archivo"
            type="object"
            class="btn-warning"
            attrs="{'invisible': [('estado', '!=', 'archivado')]}" />
          <!--Barra
          de estado-->
          <field name="estado" widget="statusbar"
            statusbar_visible="borrador,en_revision,aprobado,rechazado,archivado" clickable="true" />
          <!--Botones
          de activar y desactivar dinamicos-->
          <button
            name="action_activar"
            string="Activar"
            type="object"
            class="btn-primary"
            attrs="{'invisible': [('esta_activo', '=', True)]}" />
          <button
            name="action_desactivar"
            string="Desactivar"
            type="object"
            class="btn-secondary"
            attrs="{'invisible': [('esta_activo', '=', False)]}" />
        </header>
        <!--Cuerpo
        del Formulario-->
        <sheet>
          <group>
            <group>
              <field name="codigo" string="Codigo SKU" />
              <field name="name" string="Nombre del producto" />
              <field name="esta_activo" string="Activo" readonly="1" />
            </group>
            <group>
              <field name="estado" string="Estado del producto" readonly="1" />
              <field name="aprobado_por" string="Aprobado por"
                attrs="{'invisible': [('estado', '!=', 'aprobado')]}" />
              <field name="fecha_aprobacion" string="Fecha de aprobacion"
                attrs="{'invisible': [('estado', '!=', 'aprobado')]}" />
              <field name="cantidad_stock" string="Cantidad en stock" />
              <field name="vida_util_meses" string="Vida util en meses" />
            </group>
          </group>

          <separator string="Información de precios" />

          <group>
            <group>
              <field name="precio_compra" string="Precio de compra" />
            </group>
            <group>
              <field name="precio_venta" string="Precio de venta"
                attrs="{'readonly': [('estado', '=', 'aprobado')]}" />
            </group>
          </group>

          <!--Campos
          condicionales para rechazar-->
          <group attrs="{'invisible': [('estado', '!=', 'rechazado')]}">
            <label for="motivo_rechazo" string="Informacion del rechazo" />
            <field name="motivo_rechazo" nolabel="1" placeholder="Explique el motivo del rechazo..." />
          </group>

          <!--Widgets
          temporales-->
          <separator string="Información temporal"
            attrs="{'invisible': [('requiere_refrigeracion', '=', False), ('fecha_fabricacion', '=', False), ('fecha_vencimiento', '=', False)]}" />

          <group>
            <group>
              <!--Fechas
              con widgets personalizados-->
              <field name="fecha_fabricacion" string="Fabricación" widget="date"
                options="{'format': 'dd/MM/yyyy', 'placeholder': 'DD/MM/AAAA'}" />
              <!--Vencimiento
              depende si requiere refrigeración-->
              <field name="fecha_vencimiento" string="Vencimiento" widget="date"
                options="{'format': 'dd/MM/yyyy', 'placeholder': 'DD/MM/AAAA'}"
                attrs="{'required': [('requiere_refrigeracion', '=', True)]}" />

              <!--Campos
              calculados que se actualizan automaticamente-->
              <field name="dias_para_vencer" string="Días para vencer" widget="progressbar"
                options="{'editable': false, 'max_value': 365, 'edit_max_value': false}"
                attrs="{'invisible': [('fecha_vencimiento', '=', False)]}" />
              <field name="antiguedad_dias" string="Antiguedad (dias)" readonly="1" />
            </group>

            <group>
              <!--Campos
              datetime con zona horaria-->
              <field name="fecha_hora_recepcion" string="Recepción" widget="datetime"
                options="{'format': 'dd/MM/yyyy HH:mm:ss', 'timezone': 'user.tz'}" />
              <field name="fecha_hora_ultima_venta" string="última venta" widget="datetime"
                options="{'format': 'dd/MM/yyyy HH:mm:ss'}" readonly="1" />

              <!--Indicadores
              booleanos calculados-->
              <field name="esta_por_vencer" string="Por vencer" widget="boolean"
                attrs="{'readonly': 1, 'column_invisible': 1}" />
              <field name="alerta_stock_bajo" string="Alerta Stock Bajo" widget="boolean"
                attrs="{'readonly': 1, 'column_invisible': 1}" />
            </group>
          </group>

          <separator string="Gestión de revisiones"
            attrs="{'invisible': [('fecha_ultima_revision', '=', False), ('fecha_proxima_revision', '=', False)]}" />

          <group>
            <group>
              <field name="fecha_ultima_revision" string="Última revisión" widget="date" />
              <field name="necesita_revision" string="Necesita revisión" widget="boolean"
                attrs="{'readonly': 1}" />
            </group>
            <group>
              <field name="fecha_proxima_revision" string="Próxima revisión" widget="date"
                readonly="1" />

              <!--Botones
              para acciones temporales-->
              <button name="action_registrar_revision" string="Registrar revisión hoy" type="object"
                class="btn-primary"
                attrs="{'invisible': [('necesita_revision', '=', False)]}" />
              <button name="action_posponer_revision" string="Posponer 30 días" type="object"
                class="btn-secondary"
                attrs="{'invisible': [('necesita_revision', '=', False)]}" />
            </group>
          </group>

          <separator string="Caracteristicas especiales" />

          <!--Booleanos
          condicionales-->
          <group>
            <!--Si
            es fragil-->
            <group>
              <field name="es_fragil" string="¿Es fragil?" />
              <field name="instrucciones_fragilidad" string="Instrucciones para fragilidad"
                attrs="{'invisible': [('es_fragil', '=', False)], 'required': [('es_fragil', '=', True)]}"
                placeholder="Ej: Manejar con cuidado, no apilar, etc." />
            </group>
            <!--Si
            requiere refrigeracion-->
            <group>
              <field name="requiere_refrigeracion" string="¿Requiere refrigeracion?" />
              <field name="temperatura_refrigeracion" string="Temperatura Cº"
                attrs="{'invisible': [('requiere_refrigeracion', '=', False)], 'required': [('requiere_refrigeracion', '=', True)]}"
              />
            </group>
            <!--Si
            tiene garantía-->
            <group>
              <field name="tiene_garantia" string="¿Tiene Garantia?" />
              <field name="duracion_garantia_mes" string="Duración de la garantía (meses)"
                attrs="{'invisible': [('tiene_garantia', '=', False)], 'required': [('tiene_garantia', '=', True)]}"
              />
            </group>
          </group>

          <separator string="Detalles generales" />

          <group>
            <field name="peso_kg" string="Peso en kgs" />
            <field name="descripcion" string="Descripcion del producto" />
          </group>

          <footer>
            <field name="fecha_creacion" readonly="1" />
            <button name="action_guardar"
              string="Guardar Cambios"
              type="object"
              class="btn-primary" />
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <!--Vista
  Search con Filtros de estado-->
  <record id="view_producto_search" model="ir.ui.view">
    <field name="name">gestion.producto.search</field>
    <field name="model">gestion.producto</field>
    <field name="arch" type="xml">
      <search>
        <!--Busqueda
        rapida-->
        <field name="name" string="Nombre" />
        <field name="codigo" string="Codigo SKU" />

        <!--Filtros
        predefinidos-->
        <filter name="borrador" string="Borrador" domain="[('estado', '=', 'borrador')]" />
        <filter name="en_revision" string="En revision" domain="[('estado', '=', 'en_revision')]" />
        <filter name="aprobados" string="Aprobados" domain="[('estado', '=', 'aprobado')]" />
        <filter name="rechazados" string="Rechazados" domain="[('estado', '=', 'rechazado')]" />
        <filter name="archivados" string="Archivados" domain="[('estado', '=', 'archivado')]" />

        <!--Filtros
        booleanos-->
        <filter name="fragiles" string="Fragiles" domain="[('es_fragil', '=', True)]" />
        <filter name="refrigerados" string="Refrigerados"
          domain="[('requiere_refrigeracion', '=', True)]" />
        <filter name="con_garantia" string="Con Garantia" domain="[('tiene_garantia', '=', True)]" />

        <!--Filtros
        temporales-->
        <filter name="por_vencer_30_dias" string="Por vencer"
          domain="[('esta_por_vencer', '=', True)]" />
        <filter name="vencidos" string="Vencidos"
          domain="[('fecha_vencimiento', '!=', False), ('fecha_vencimiento', '&lt;', context_today())]" />
        <filter name="necesitan_revision" string="Por revisar"
          domain="[('necesita_revision', '=', True)]" />
        <filter name="alerta_stock" string="Con Alerta stock"
          domain="[('alerta_stock_bajo','=', True)]" />
        <filter name="recepcion_ultima_semana" string="Recibidos Última Semana"
          domain="[('fecha_hora_recepcion','&gt;=',(context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]" />
        <separator />

        <!--Filtros
        por rango de fechas (Personalizado)-->
        <filter name="filter_fecha_vencimiento" string="Vencimiento"
          date="fecha_vencimiento" />
        <filter name="filter_fecha_fabricacion" string="Fabricación" date="fecha_fabricacion" />

        <separator />

        <!--Filtro
        grupal (Por estado)-->
        <filter name="group_estado" string="Agrupar por estado" context="{'group_by': 'estado'}" />
        <!--Vencimiento
        (mes)-->
        <filter name="group_por_mes_vencimiento" string="Agrupar por mes de vencimiento"
          context="{'group_by': 'fecha_vencimiento:month'}" />

        <separator />

        <!--Filtros
        combinados-->
        <filter name="activos_aprobados" string="Activos y Aprobados"
          domain="[('esta_activo', '=', True), ('estado', '=', 'aprobado')]" />
        <filter name="sin_stock" string="Sin Stock"
          domain="[('cantidad_stock','=',0)]" />
      </search>
    </field>
  </record>

  <!--Acción
  de Ventana-->
  <record id="action_producto" model="ir.actions.act_window">
    <field name="name">Productos</field>
    <field name="res_model">gestion.producto</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_producto_search" />
    <field name="context">{'search_default_activos_aprobados': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No hay productos creados aún
      </p>
      <p>
        Cree su primer producto en "Crear"
      </p>
    </field>
  </record>

</odoo>