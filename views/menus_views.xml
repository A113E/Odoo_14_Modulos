<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--Acción de ventana: Define que se hace
  cuando se da click en el menú-->
  <record id="action_hola_mundo" model="ir.actions.act_window">
    <field name="name">Hola Mundo</field>
    <field name="res_model">hola.mundo</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        !Mi primer Módulo!
      </p>
    </field>
  </record>

  <!--Menu
  principal: Define donde aparece en la interfaz-->
  <menuitem
    id="menu_hola_mundo_root"
    name="Mi primer Módulo"
    sequence="10"
    web_icon="hola_mundo,static/description/icon.png" />

  <!--Subemenú:
  El elemento en el que realmente el usuario hace click-->
  <menuitem
    id="menu_hola_mundo"
    name="Hola Mundo"
    parent="menu_hola_mundo_root"
    action="action_hola_mundo"
    sequence="10" />

</odoo>