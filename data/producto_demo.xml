    ]]></field>

    <field name="manual_usuario"><![CDATA[
    <h1>Manual de Usuario Dell XPS 13</h1>
    <h2>Contenido del Paquete</h2>
    <ul>
      <li>Laptop Dell XPS 13</li>
      <li>Adaptador de corriente USB-C</li>
      <li>Cable USB-C a USB-C</li>
      <li>Documentación y garantía</li>
    </ul>

    <h2>Primeros Pasos</h2>
    <ol>
      <li>Conecte el adaptador de corriente</li>
      <li>Presione el botón de encendido</li>
      <li>Siga las instrucciones de configuración de Windows</li>
    </ol>
    ]]></field>
    <field name="cantidad_stock">5</field>
    <field name="precio_compra">1200.00</field>
    <field name="precio_venta">1500.00</field>
    <field name="peso_kg">1.2</field>
    <field name="vida_util_meses">36</field>
    <field name="esta_activo">True</field>
    <field name="es_fragil">True</field>
    <field name="instrucciones_fragilidad">No golpear, transportar en maletín rígido</field>
    <field name="tiene_garantia">True</field>
    <field name="duracion_garantia_mes">24</field>
    <field name="fecha_aprobacion"
      eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="aprobado_por" ref="base.user_admin" />
    <!-- No perecedero con revisión, sin fecha de vencimiento -->
    <field name="fecha_ultima_revision"
      eval="(datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=15, hours=2, minutes=30)).strftime('%Y-%m-%d %H:%M:%S')" />
    <!-- Sin fecha de vencimiento para demostrar no perecedero -->
  </record>

  <!-- Producto 2: Aprobado, por vencer (para mostrar decoration-warning) -->
  <record id="producto_demo_2" model="gestion.producto">
    <field name="codigo">PROD-00002</field>
    <field name="name">Mouse Inalámbrico Logitech</field>
    <field name="descripcion">Mouse ergonómico inalámbrico, batería de 12 meses</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_perifericos" />
    <field name="cantidad_stock">50</field>
    <field name="precio_compra">25.00</field>
    <field name="precio_venta">40.00</field>
    <field name="peso_kg">0.150</field>
    <field name="vida_util_meses">24</field>
    <field name="esta_activo">True</field>
    <field name="es_fragil">False</field>
    <!-- Campos para mostrar "por vencer" (menos de 30 días) -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=180)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() + timedelta(days=15)).strftime('%Y-%m-%d')" />
    <!-- Activará: esta_por_vencer = True -->
    <field name="fecha_ultima_revision"
      eval="(datetime.now() - timedelta(days=60)).strftime('%Y-%m-%d')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=5, hours=8)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

  <!-- Producto 3: En revisión, necesita revisión -->
  <record id="producto_demo_3" model="gestion.producto">
    <field name="codigo">PROD-00003</field>
    <field name="name">Teclado Mecánico Redragon</field>
    <field name="descripcion">Teclado mecánico gaming con retroiluminación RGB</field>
    <field name="estado">en_revision</field>
    <field name="categoria_id" ref="categoria_perifericos" />
    <field name="cantidad_stock">15</field>
    <field name="precio_compra">60.00</field>
    <field name="precio_venta">90.00</field>
    <field name="peso_kg">1.050</field>
    <field name="vida_util_meses">30</field>
    <field name="esta_activo">True</field>
    <field name="es_fragil">True</field>
    <field name="instrucciones_fragilidad">No exponer a líquidos, limpiar con paño seco</field>
    <!-- Campos nuevos para producto en revisión con fecha de vencimiento normal -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() + timedelta(days=60)).strftime('%Y-%m-%d')" />
    <field name="fecha_ultima_revision"
      eval="(datetime.now() - timedelta(days=120)).strftime('%Y-%m-%d')" />
    <field name="necesita_revision">True</field>
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=10, hours=6, minutes=45)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

  <!-- Producto 4: Aprobado, refrigerado, por vencer -->
  <record id="producto_demo_4" model="gestion.producto">
    <field name="codigo">PROD-00004</field>
    <field name="name">Yogur Natural 1kg</field>
    <field name="descripcion">Yogur natural sin azúcar, envase de 1kg</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_lacteos" />
    <field name="cantidad_stock">100</field>
    <field name="precio_compra">3.50</field>
    <field name="precio_venta">5.00</field>
    <field name="peso_kg">1.1</field>
    <field name="vida_util_meses">1</field>
    <field name="esta_activo">True</field>
    <field name="requiere_refrigeracion">True</field>
    <field name="temperatura_refrigeracion">4.0</field>
    <field name="tiene_garantia">False</field>
    <!-- Campos para producto perecedero POR VENCER (menos de 30 días) -->
    <field name="fecha_fabricacion" eval="(datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() + timedelta(days=10)).strftime('%Y-%m-%d')" />
    <!-- Activará: esta_por_vencer = True (10 días < 30) -->
    <field name="fecha_hora_recepcion"
      eval="(datetime.now() - timedelta(days=4, hours=3)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=1, hours=5)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

  <!-- Producto 5: POR VENCER (fecha futura cercana) -->
  <record id="producto_demo_5" model="gestion.producto">
    <field name="codigo">PROD-00005</field>
    <field name="name">Leche Entera 1L</field>
    <field name="descripcion">Leche entera pasteurizada, envase tetra pack 1 litro</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_lacteos" />
    <field name="cantidad_stock">30</field>
    <field name="precio_compra">1.20</field>
    <field name="precio_venta">1.80</field>
    <field name="peso_kg">1.05</field>
    <field name="vida_util_meses">1</field>
    <field name="esta_activo">True</field>
    <field name="requiere_refrigeracion">True</field>
    <field name="temperatura_refrigeracion">4.0</field>
    <field name="tiene_garantia">False</field>
    <!-- CORREGIDO: Fecha futura (por vencer) en lugar de vencida -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=20)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() + timedelta(days=5)).strftime('%Y-%m-%d')" />
    <!-- Activará: esta_por_vencer = True (5 días < 30) -->
    <field name="fecha_hora_recepcion"
      eval="(datetime.now() - timedelta(days=18, hours=2)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=3, hours=2)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

  <!-- Producto 6: VENCIDO PERO INACTIVO (para mostrar que puede existir) -->
  <record id="producto_demo_6" model="gestion.producto">
    <field name="codigo">PROD-00006</field>
    <field name="name">Prototipo de Smartwatch Vencido</field>
    <field name="descripcion">Prototipo vencido en desarrollo, no disponible para venta</field>
    <field name="estado">borrador</field>
    <field name="categoria_id" ref="categoria_electronica" />
    <field name="cantidad_stock">2</field>
    <field name="precio_compra">200.00</field>
    <field name="precio_venta">0.00</field>
    <field name="peso_kg">0.080</field>
    <field name="vida_util_meses">6</field>
    <!-- IMPORTANTE: Inactivo para poder tener fecha pasada -->
    <field name="esta_activo">False</field>
    <field name="es_fragil">True</field>
    <field name="instrucciones_fragilidad">Manejar con guantes antiestáticos</field>
    <!-- Vencido pero inactivo (permite fecha pasada) -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=400)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() - timedelta(days=100)).strftime('%Y-%m-%d')" />
    <!-- Vencido (inactivo) -->
    <!-- Necesita revisión (más de 6 meses desde última revisión) -->
    <field name="fecha_ultima_revision"
      eval="(datetime.now() - timedelta(days=200)).strftime('%Y-%m-%d')" />
    <field name="necesita_revision">True</field>
    <!-- Como es prototipo y no está activo, no tiene ventas -->
  </record>

  <!-- Producto 7: VENCIDO E INACTIVO con motivo de rechazo -->
  <record id="producto_demo_7" model="gestion.producto">
    <field name="codigo">PROD-00007</field>
    <field name="name">Cargador USB Vencido</field>
    <field name="descripcion">Lote de cargadores USB vencidos con falla de fabricación</field>
    <field name="estado">rechazado</field>
    <field name="motivo_rechazo">El producto ha vencido y no cumple con los estándares de seguridad
      eléctrica actuales.</field>
    <field name="categoria_id" ref="categoria_electronica" />
    <field name="cantidad_stock">0</field>
    <field name="precio_compra">5.00</field>
    <field name="precio_venta">0.00</field>
    <field name="peso_kg">0.080</field>
    <field name="vida_util_meses">12</field>
    <field name="esta_activo">False</field>
    <!-- Vencido hace tiempo e inactivo -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=500)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() - timedelta(days=200)).strftime('%Y-%m-%d')" />
    <!-- Vencido e inactivo -->
  </record>

  <!-- Producto 8: Con alerta de stock bajo -->
  <record id="producto_demo_8" model="gestion.producto">
    <field name="codigo">PROD-00008</field>
    <field name="name">Batería Externa 10000mAh</field>
    <field name="descripcion">Batería portátil para cargar dispositivos móviles</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_electronica" />
    <field name="cantidad_stock">3</field>
    <!-- Stock bajo (≤5) para activar alerta -->
    <field name="precio_compra">15.00</field>
    <field name="precio_venta">25.00</field>
    <field name="peso_kg">0.220</field>
    <field name="vida_util_meses">24</field>
    <field name="esta_activo">True</field>
    <!-- Para activar alerta_stock_bajo: stock ≤5 y recepción hace más de 30 días -->
    <field name="fecha_hora_recepcion"
      eval="(datetime.now() - timedelta(days=45, hours=5)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=2, hours=1)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

  <!-- Producto 9: Producto lejano a vencer (más de 30 días) -->
  <record id="producto_demo_9" model="gestion.producto">
    <field name="codigo">PROD-00009</field>
    <field name="name">Aceite de Oliva Extra Virgen 1L</field>
    <field name="descripcion">Aceite de oliva de primera prensada en frío</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_alimentos" />
    <field name="cantidad_stock">25</field>
    <field name="precio_compra">8.50</field>
    <field name="precio_venta">12.00</field>
    <field name="peso_kg">1.1</field>
    <field name="vida_util_meses">24</field>
    <field name="esta_activo">True</field>
    <!-- Producto lejano a vencer (más de 30 días) -->
    <field name="fecha_fabricacion"
      eval="(datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')" />
    <field name="fecha_vencimiento"
      eval="(datetime.now() + timedelta(days=180)).strftime('%Y-%m-%d')" />
    <!-- NO activará esta_por_vencer (180 días > 30) -->
    <field name="fecha_hora_recepcion"
      eval="(datetime.now() - timedelta(days=25, hours=3)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="fecha_hora_ultima_venta"
      eval="(datetime.now() - timedelta(days=7, hours=4)).strftime('%Y-%m-%d %H:%M:%S')" />
  </record>

</odoo>