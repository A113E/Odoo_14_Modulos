<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <?python
from datetime import datetime, timedelta
now = datetime.now()?>

  <!-- Categorias a relacionar -->
  <record id="categoria_electronica" model="categoria.producto">
    <field name="name">Electrónica</field>
    <field name="codigo">CAT-001</field>
    <field name="descripcion">Productos electrónicos y tecnológicos</field>
    <field name="sequence">10</field>
  </record>

  <record id="categoria_computadoras" model="categoria.producto">
    <field name="name">Computadoras</field>
    <field name="codigo">CAT-002</field>
    <field name="parent_id" ref="categoria_electronica" />
    <field name="descripcion">Computadoras, laptops y tablets</field>
    <field name="sequence">20</field>
  </record>

  <record id="categoria_perifericos" model="categoria.producto">
    <field name="name">Periféricos</field>
    <field name="codigo">CAT-003</field>
    <field name="parent_id" ref="categoria_electronica" />
    <field name="descripcion">Teclados, mouses, monitores, etc.</field>
    <field name="sequence">30</field>
  </record>

  <record id="categoria_alimentos" model="categoria.producto">
    <field name="name">Alimentos</field>
    <field name="codigo">CAT-004</field>
    <field name="descripcion">Productos alimenticios y bebidas</field>
    <field name="sequence">40</field>
  </record>

  <record id="categoria_lacteos" model="categoria.producto">
    <field name="name">Lácteos</field>
    <field name="codigo">CAT-005</field>
    <field name="parent_id" ref="categoria_alimentos" />
    <field name="descripcion">Leche, yogur, queso, etc.</field>
    <field name="sequence">50</field>
  </record>

  <!-- Producto 1: Aprobado, no perecedero, sin vencimiento -->
  <record id="producto_demo_1" model="gestion.producto">
    <field name="codigo">PROD-00001</field>
    <field name="name">Laptop Dell XPS 13</field>
    <field name="descripcion">Laptop ultrabook de 13 pulgadas, 16GB RAM, 512GB SSD</field>
    <field name="estado">aprobado</field>
    <field name="categoria_id" ref="categoria_computadoras" />
    <field name="descripcion_larga"><![CDATA[
    <h2>Laptop Dell XPS 13 - Potencia y Elegancia</h2>
    <p>La <strong>Dell XPS 13</strong> redefine lo que es posible en una laptop de 13 pulgadas. Con un diseño infinitamente elegante y potencia de sobra para cualquier tarea.</p>

    <h3>Características Principales:</h3>
    <ul>
      <li><b>Pantalla:</b> 13.4" 4K UHD+ InfinityEdge Touch</li>
      <li><b>Procesador:</b> Intel Core i7 de 11ª generación</li>
      <li><b>Memoria:</b> 16GB LPDDR4x</li>
      <li><b>Almacenamiento:</b> 512GB SSD M.2 PCIe NVMe</li>
      <li><b>Gráficos:</b> Intel Iris Xe</li>
    </ul>

    <h3>Diseño Innovador:</h3>
    <p>Marco infinito que maximiza la pantalla en un chasis compacto. Construido en aluminio y fibra de carbono para durabilidad y estilo.</p>
    ]]></field>

    <field name="especificaciones_tecnicas"><![CDATA[
    Sistema Operativo: Windows 11 Pro
    Procesador: Intel Core i7-1165G7 (12MB cache, hasta 4.7 GHz)
